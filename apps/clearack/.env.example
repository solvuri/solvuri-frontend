# Base URL for @repo/api-client's createApiClient (used by lib/api.ts's
# clearackApi and lib/clearackApi.ts) — the real backend-api-test
# environment for now.
NEXT_PUBLIC_API_URL=https://backend-api-test.solvuri.com

# Production root domain for subdomain-based storefront routing (proxy.ts).
# Falls back to "clearack.xyz" if unset — only needs setting to override that.
ROOT_DOMAIN=clearack.xyz
