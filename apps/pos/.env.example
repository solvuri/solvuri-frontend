# Base URL for @repo/api-client's createApiClient (used by lib/api.ts's posApi)
NEXT_PUBLIC_API_URL=https://api.solvuri.com/v1

# Production root domain for subdomain-based register routing (proxy.ts).
# Falls back to "solvuripos.xyz" if unset — placeholder, only needs setting
# to override that once a real domain is confirmed.
POS_ROOT_DOMAIN=solvuripos.xyz
